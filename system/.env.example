# Copy to .env locally. On Hostinger these go in the Web App's
# "Environment variables" panel instead — never in this repo.
#
# NOTE: .gitignore un-ignores THIS file (.env.example) so the variable names
# are documented, but it must never carry a real value. The last time a repo
# in this account shipped a real password in a committed .env.example, that
# password ended up readable on public GitHub. Placeholders only.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Long random string. Generate with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# What the team types to get in. Do not reuse a password from any other app.
APP_PASSWORD=

PORT=3000
NODE_ENV=production

# ---------------------------------------------------------------- sources
# The hub PULLS from the systems the team already fills in. Nobody types this
# data here; these are read-only anon keys for two Supabase projects.
#
#   REPORTS      what reports-six-coral.vercel.app writes (shifts, actions,
#                mistakes). Ten profiles share it; X Studioz is one slice.
#   IMPRESSIONS  what impressions-hmi.vercel.app writes (daily reach per gig).
#
# Both keys are already public in those apps' own browser bundles. They live
# here rather than in the repo because a key committed to git is a key nobody
# can rotate. Find them in the app's /assets/index-*.js, or in the Supabase
# dashboard under Project Settings, API, anon public.
REPORTS_SUPABASE_KEY=
IMPRESSIONS_SUPABASE_KEY=
# Optional, only if a project moves.
# REPORTS_SUPABASE_URL=https://aeytsgipuuyjlbvebhez.supabase.co
# IMPRESSIONS_SUPABASE_URL=https://jkigyrnvlfcwloqtrycu.supabase.co

# ---------------------------------------------------------------- tuning
# All optional. Every one has a working default in code and the hub is correct
# without them, so they do not belong in the Hostinger panel unless something
# specific needs changing. They are listed because a variable the code reads
# and no file mentions is one nobody can discover without grepping, which is
# how the two Supabase keys above ended up unset on the live hub.

# Where the engine's published JSON is read from. Defaults to system/data.
# XSTUDIOZ_DATA_DIR=

# Set to 0 only when running over plain http locally; on the live host the
# session cookie must stay Secure.
# COOKIE_SECURE=

# MySQL pool behaviour. Defaults are tuned for Hostinger's connection limit;
# raising DB_POOL_SIZE past it fails as refused connections, not slowness.
# DB_POOL_SIZE=
# DB_CONNECT_TIMEOUT_MS=
# DB_BREAKER_MS=
